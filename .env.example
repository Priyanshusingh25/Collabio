# ============================================================================
# Collabio — environment configuration
# Copy to `server/.env` for local development (never commit real secrets).
# ============================================================================

# --- runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3001

# Origin allowed through CORS (the Vite dev server by default).
CLIENT_URL=http://localhost:5173

# --- database --------------------------------------------------------------
# SQLite file path. Relative paths resolve from the repository root.
# In PostgreSQL-ready deployments this is the single switch point used by
# server/src/database/db.js.
DB_PATH=server/db/collabio.db

# (Reserved) PostgreSQL connection string for the production driver.
# DATABASE_URL=postgres://user:password@host:5432/collabio

# --- security --------------------------------------------------------------
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=50
RATE_LIMIT_API_MAX=600

# --- background jobs -------------------------------------------------------
# Follow-up/reminder/deadline sweep cadence (ms). Default 15 minutes.
JOBS_INTERVAL_MS=900000

# --- logging ---------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=debug

# --- demo workspace --------------------------------------------------------
# Set to 0 to disable the automatically-seeded demo account.
SEED_DEMO_USER=1